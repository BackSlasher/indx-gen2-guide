  {
   "id": 1096341,
   "title": "View high resolution images",
   "updated": "2026-07-14 14:10:10",
   "lines": [
    {
     "html": "When you browse the guide on <a href=\"https://help.prusa3d.com\">help.prusa3d.com</a>, you can view the original images in high resolution for clarity.",
     "color": null,
     "icon": null,
     "level": 0
    },
    {
     "html": "Just click on the image to open it in high resolution for a detailed view.",
     "color": "green",
     "icon": null,
     "level": 0
    },
    {
     "html": "Click on <strong>Fullscreen mode</strong> or press the F key to maximize your screen space and focus entirely on the instructions.",
     "color": "blue",
     "icon": null,
     "level": 0
    }
   ],
