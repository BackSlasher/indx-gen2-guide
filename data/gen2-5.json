  {
   "id": 1136547,
   "title": "Finish",
   "updated": "2026-08-18 07:50:40",
   "lines": [
    {
     "html": "Congratulations! Your upgraded CORE One+ (Gen 2) is ready to roll!",
     "color": null,
     "icon": "reminder",
     "level": 0
    },
    {
     "html": "<strong>Happy printing!</strong>",
     "color": null,
     "icon": null,
     "level": 0
    }
   ],
   "gallery": [
    {
