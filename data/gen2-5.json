  {
   "id": 1136529,
   "title": "Selftest",
   "updated": "2026-07-23 13:14:25",
   "lines": [
    {
     "html": "After finishing the upgrade, we recommend visiting the menu <em><strong>Control -&gt; Calibrations &amp; Tests </strong></em>and run the Selftest from the start.",
     "color": "green",
     "icon": null,
     "level": 0
    }
   ],
