  {
   "id": 1136483,
   "title": "Firmware Flash",
   "updated": "2026-07-23 13:14:20",
   "lines": [
    {
     "html": "Insert the USB drive with the firmware file into the printer.",
     "color": "violet",
     "icon": null,
     "level": 0
    },
    {
     "html": "Connect the power cable.",
     "color": "yellow",
     "icon": null,
     "level": 0
    },
    {
     "html": "Turn the printer on using the switch on the back.",
     "color": "green",
     "icon": null,
     "level": 0
    },
    {
     "html": "Once the \"New firmware available\" screen appears, select the <strong>FLASH</strong> option.",
     "color": "blue",
     "icon": null,
     "level": 0
    }
   ],
