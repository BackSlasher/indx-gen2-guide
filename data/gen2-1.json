 "slug": "1-introduction_1110653",
 "title": "1. Introduction",
 "manual": "Prusa CORE One+ to (Gen 2) upgrade",
 "manual_slug": "prusa-core-one-to-gen-2-upgrade_2435",
 "difficulty": "Very easy",
 "updated": "2026-08-20 08:16:57",
 "steps": [
  {
   "id": 1116634,
   "title": "Preparing the upgrade kit",
   "updated": "2026-08-18 06:55:42",
   "lines": [
    {
     "html": "This manual guides you through upgrading your <strong>Prusa CORE One+ to CORE One+ (Gen 2)</strong>.",
     "color": null,
     "icon": null,
     "level": 0
    },
    {
     "html": "Please prepare the upgrade kit received from Prusa Research.",
     "color": null,
     "icon": null,
     "level": 0
    },
    {
     "html": "All the required plastic parts are included in the kit.",
     "color": null,
     "icon": "note",
     "level": 1
    },
    {
     "html": "The printable parts are also available on Printables.",
     "color": null,
     "icon": "reminder",
     "level": 1
    }
   ],
   "gallery": [
    {
     "original": "https://help.prusa3d.com/wp-content/uploads/2026/07/0c20043120a15c35.jpg",
