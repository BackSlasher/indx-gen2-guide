    }
   ]
  },
  {
   "id": 1116725,
   "title": "Tools Required",
   "updated": "2026-07-23 07:11:40",
   "lines": [
    {
     "html": "The tools needed for this upgrade are <strong>not included in the kit</strong>. Please use the tools that came with your original CORE One+ printer.",
     "color": null,
     "icon": "reminder",
     "level": 0
    },
    {
     "html": "<strong>For the following chapters, please prepare these tools:</strong>",
     "color": null,
     "icon": null,
     "level": 0
    },
    {
     "html": "2.0mm Allen key",
     "color": "red",
     "icon": null,
     "level": 0
    },
    {
     "html": "2.5mm Allen key",
     "color": "yellow",
     "icon": null,
     "level": 0
    },
    {
     "html": "T10 Torx key / Screwdriver",
     "color": "light_blue",
     "icon": null,
     "level": 0
    },
    {
     "html": "Needle-nose pliers",
     "color": "green",
     "icon": null,
     "level": 0
    },
    {
     "html": "Unikey with the M3 nut-sized opening.",
     "color": "orange",
     "icon": null,
     "level": 0
    }
   ],
