  {
   "id": 1116867,
   "title": "Unplugging the printer",
   "updated": "2026-07-23 07:43:19",
   "lines": [
    {
     "html": "Before you begin, make sure the <strong>printer has cooled down</strong> to ambient temperature.",
     "color": null,
     "icon": "caution",
     "level": 0
    },
    {
     "html": "Turn the printer off using the switch on the back.<br />",
     "color": "green",
     "icon": null,
     "level": 0
    },
    {
     "html": "Disconnect the printer from power.<br />",
     "color": "yellow",
     "icon": null,
     "level": 0
    },
    {
     "html": "Remove the steel sheet (optional).",
     "color": "orange",
     "icon": null,
     "level": 0
    }
   ],
