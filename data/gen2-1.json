  {
   "id": 1116803,
   "title": "Unloading the filament",
   "updated": "2026-07-23 07:42:53",
   "lines": [
    {
     "html": "Unload the filament. Visit the menu <strong>Filament</strong> and select <strong>Unload filament</strong>.",
     "color": "light_blue",
     "icon": null,
     "level": 0
    },
    {
     "html": "Unload the filament from the printer.",
     "color": "yellow",
     "icon": null,
     "level": 0
    },
    {
     "html": "Remove the filament spool from the printer.",
     "color": null,
     "icon": null,
     "level": 0
    }
   ],
